      "position": [
        656,
        304
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "5Cwe4Bxkw2Nbfwmx",
          "name": "ClickUp API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return ($json.tasks || []).map(t => ({ json: { id: t.id, name: t.name } }));"
      },
      "id": "b8000000-0000-4000-8000-000000000003",
      "name": "Split Completed Tasks",
      "type": "n8n-nodes-base.code",
