      "position": [
        912,
        304
      ]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "=https://api.clickup.com/api/v2/task/{{ $json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b8000000-0000-4000-8000-000000000004",
      "name": "Delete Task",
