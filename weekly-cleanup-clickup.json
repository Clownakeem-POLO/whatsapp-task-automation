{
  "name": "Weekly Cleanup - Purge Completed ClickUp Tasks",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtHour": 2
            }
          ]
        }
      },
      "id": "b8000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
