        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "include_closed",
              "value": "true"
            },
            {
              "name": "statuses[]",
              "value": "complete"
            }
          ]
        },
        "options": {}
      },
      "id": "b8000000-0000-4000-8000-000000000002",
      "name": "Get Completed Tasks",
      "type": "n8n-nodes-base.httpRequest",
